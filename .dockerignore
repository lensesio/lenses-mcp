# Keep the build context to what the Dockerfile actually copies. The
# Dockerfile only COPYs specific paths, so nothing here leaks today —
# this is belt-and-braces against a future `COPY . .` picking up a
# developer's real .env, and it keeps the context small.

# Secrets — .env is gitignored, so a local one may hold live credentials.
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Virtual environments and build artifacts
.venv
__pycache__
*.py[cod]
*.egg-info
dist
build

# Tooling caches
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
coverage.xml
htmlcov

# Not needed at runtime
tests
.github
.claude
.pre-commit-config.yaml
Makefile
README.md
