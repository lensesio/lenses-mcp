# This is the default config for Community Edition running locally

# Lenses instance URL
LENSES_URL=http://localhost:9991

# Your Lenses API key (required)
LENSES_API_KEY=YOUR_LENSES_API_KEY

# Legacy configuration (optional - these are automatically derived from LENSES_URL)
# LENSES_API_HTTP_URL=http://localhost
# LENSES_API_HTTP_PORT=9991
# LENSES_API_WEBSOCKET_URL=ws://localhost
# LENSES_API_WEBSOCKET_PORT=9991

# FastMCP log level (default: INFO)
FASTMCP_LOG_LEVEL=INFO

# MCP server transport: stdio (default), http, sse, or streamable-http
TRANSPORT=stdio

# Host and port to bind when using an HTTP-based transport
# (ignored when TRANSPORT=stdio)
HOST=0.0.0.0
PORT=8000

# Stateless HTTP mode for the MCP server.
# Recommended for horizontally scaled HTTP deployments behind a load balancer:
# each request is independent, so no sticky sessions or shared session store
# are needed. Set to "false" only if you need MCP server-initiated notifications
# or long-lived SSE streams.
FASTMCP_STATELESS_HTTP=true

# When AUTH_SERVER_URL is set, the MCP server runs as an OAuth 2.1 protected
# resource: clients must obtain a bearer token from the auth server via PKCE
# and bearer tokens are validated via RFC 7662 Token Introspection before being
# forwarded to the Lenses API. When unset, the server runs unauthenticated and
# falls back to LENSES_API_KEY above.
#
# Only meaningful for HTTP transports; ignored when TRANSPORT=stdio.

# Base URL of the OAuth 2.1 authorization server (no trailing path).
# Example: https://lenses.example.com
# AUTH_SERVER_URL=https://lenses.example.com

# Public base URL of this MCP server, as reachable by OAuth clients.
# Published in /.well-known/oauth-protected-resource/mcp as the "resource"
# field, so it must match the URL clients actually connect to (including
# scheme, host, and any reverse-proxy prefix).
# Required whenever AUTH_SERVER_URL is set.
# MCP_SERVER_BASE_URL=http://localhost:8000

# OAuth scopes the resource requires, comma-separated. Published in the
# protected-resource metadata so compliant clients include them in their
# /authorize request. Default covers read/write/delete across Lenses APIs.
# Narrow to "read" for a read-only deployment.
# MCP_SCOPES=read,write,delete

# ── RFC 7662 Token Introspection ──────────────────────────────────────
# On first use the MCP server discovers the auth server's metadata at
# {AUTH_SERVER_URL}/.well-known/oauth-authorization-server to locate the
# introspection endpoint. The introspection endpoint is called without
# client authentication.

# Override the introspection endpoint URL. When unset, the URL is read
# from the auth server's metadata (introspection_endpoint field),
# falling back to {AUTH_SERVER_URL}/oauth2/introspect.
# INTROSPECTION_URL=https://lenses.example.com/oauth2/introspect

# Cache TTL for introspection results, in seconds. 0 (default) disables
# caching, meaning every request triggers a call to the introspection
# endpoint. Set to a positive value (e.g. 300 for 5 min) to reduce
# load on the auth server at the cost of delayed revocation detection.
# INTROSPECTION_CACHE_TTL=0